# LeakSanitizer suppressions for vendored code, used by `make test-asan`.

# MicroHs 0.16.9: closeb_lzma frees its buffer only in write mode, so each
# compressed read leaks the one add_lzma_decompressor allocates. Upstream
# master's streaming LZMA decoder frees it; drop this at the next release.
leak:add_lzma_decompressor

# s7: permanent strings made by s7_init, deliberately outside all s7 GCs
leak:make_permanent_string

# Guile: objects that only its GC frees (midi-out smobs, libguile internals);
# the GC does not run before exit
leak:libguile
leak:g_midi_open
